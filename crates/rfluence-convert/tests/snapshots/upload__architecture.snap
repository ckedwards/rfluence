          "extensionTitle": "Merfluence",
          "forgeEnvironment": "PRODUCTION",
          "guestParams": {
            "source": "sequenceDiagram\n    participant P as Producer\n    participant G as Gateway\n    participant W as Worker\n    P->>G: POST /v1/events\n    G-->>P: 202 Accepted\n    G->>W: enqueue\n    W->>W: batch & write",
            "theme": "dark"
          },
          "layout": "extension"
        },
        "text": "Merfluence"
      }
