        "level": 1
      },
      "content": [
        {
          "type": "text",
          "text": "Ingestion Service Architecture"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Overview"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "The ingestion service receives events from upstream producers, validates them, and writes them to the "
        },
        {
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ],
          "text": "event store"
        },
        {
          "type": "text",
          "text": ". It is designed for "
        },
        {
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ],
          "text": "at-least-once"
        },
        {
          "type": "text",
          "text": " delivery and horizontal scaling."
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This document describes the target architecture for Q3. See "
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "./current-state.md"
                  }
                }
              ],
              "text": "the current state"
            },
            {
              "type": "text",
              "text": " for what is deployed today."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Components"
        }
