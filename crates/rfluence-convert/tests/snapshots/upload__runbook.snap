---
source: crates/rfluence-convert/tests/upload.rs
expression: "format!(\"{json}\\n\\ndiagnostics: {:#?}\", upload.diagnostics)"
---
{
  "type": "doc",
  "content": [
    {
      "type": "heading",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "type": "text",
          "text": "Runbook: Database Failover"
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "note"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Only on-call engineers with production access should run this procedure."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Before you start"
        }
      ]
    },
    {
      "type": "taskList",
      "attrs": {
        "localId": "000000000001"
      },
      "content": [
        {
          "type": "taskItem",
          "attrs": {
            "localId": "000000000002",
            "state": "TODO"
          },
          "content": [
            {
              "type": "text",
              "text": "Page the database owner in "
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "code"
                }
              ],
              "text": "#db-oncall"
            }
          ]
        },
        {
          "type": "taskItem",
          "attrs": {
            "localId": "000000000003",
            "state": "TODO"
          },
          "content": [
            {
              "type": "text",
              "text": "Confirm the replica lag is under 5 seconds"
            }
          ]
        },
        {
          "type": "taskItem",
          "attrs": {
            "localId": "000000000004",
            "state": "TODO"
          },
          "content": [
            {
              "type": "text",
              "text": "Open a change ticket"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Procedure"
        }
      ]
    },
    {
      "type": "orderedList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Check the replica status:"
                }
              ]
            },
            {
              "type": "codeBlock",
              "attrs": {
                "language": "shell"
              },
              "content": [
                {
                  "type": "text",
                  "text": "psql -h replica-1.internal -c \"SELECT now() - pg_last_xact_replay_timestamp() AS lag;\""
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Stop writes to the primary:"
                }
              ]
            },
            {
              "type": "orderedList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Set the app to read-only mode with Ctrl+R in the admin console."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Wait for in-flight transactions to finish."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Promote the replica:"
                }
              ]
            },
            {
              "type": "codeBlock",
              "attrs": {
                "language": "shell"
              },
              "content": [
                {
                  "type": "text",
                  "text": "pg_ctl promote -D /var/lib/postgresql/data"
                }
              ]
            },
            {
              "type": "panel",
              "attrs": {
                "panelType": "success"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "If "
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ],
                      "text": "pg_ctl"
                    },
                    {
                      "type": "text",
                      "text": " isn't on the "
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ],
                      "text": "PATH"
                    },
                    {
                      "type": "text",
                      "text": ", use the full path: "
                    },
                    {
                      "type": "text",
                      "marks": [
                        {
                          "type": "code"
                        }
                      ],
                      "text": "/usr/lib/postgresql/16/bin/pg_ctl"
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Update the DNS record "
                },
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ],
                  "text": "db.internal"
                },
                {
                  "type": "text",
                  "text": " to point at the new primary."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "error"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Do "
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ],
              "text": "not"
            },
            {
              "type": "text",
              "text": " restart the old primary until it has been rebuilt as a replica. Two primaries will cause split-brain."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Verifying"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Run the health check and confirm all checks pass "
        },
        {
          "type": "emoji",
          "attrs": {
            "id": "2705",
            "shortName": ":white_check_mark:",
            "text": "✅"
          }
        },
        {
          "type": "text",
          "text": ". If anything fails, roll back immediately "
        },
        {
          "type": "emoji",
          "attrs": {
            "id": "1f6a8",
            "shortName": ":rotating_light:",
            "text": "🚨"
          }
        },
        {
          "type": "text",
          "text": "."
        }
      ]
    },
    {
      "type": "expand",
      "attrs": {
        "title": "Expected health check output"
      },
      "content": [
        {
          "type": "codeBlock",
          "attrs": {
            "language": "plaintext"
          },
          "content": [
            {
              "type": "text",
              "text": "db.primary ........ ok\ndb.replica ........ ok\nreplication lag ... 0.2s"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "type": "text",
          "text": "Rollback"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Point "
                },
                {
                  "type": "text",
                  "marks": [
                    {
                      "type": "code"
                    }
                  ],
                  "text": "db.internal"
                },
                {
                  "type": "text",
                  "text": " back at the old primary."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Re-enable writes."
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Clear the read-only flag."
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Notify the team."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "text": "Contact the DB team if you are unsure."
        }
      ]
    }
  ],
  "version": 1
}

