                      "type": "paragraph",
                      "attrs": {
                        "localId": "ce55a4ae0d51"
                      },
                      "content": [
                        {
                          "text": "1,000 requests/minute per key",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "attrs": {
                    "localId": "aa1e3081-0e41-47ea-b6ad-94dfc8e0f54a"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "localId": "0d915de9b09f"
                      },
                      "content": [
                        {
                          "text": "10 MB maximum body size",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "3fa50200-017c-4188-a2a8-54e312872b36"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "f75eb003608c"
              },
              "content": [
                {
                  "text": "The validator checks each event against its schema.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "codeBlock",
              "attrs": {
                "localId": "4db92086-e80d-42cd-a5b5-881426df216d"
              },
              "content": [
                {
                  "text": "pub fn validate(event: &Event, schema: &Schema) -> Result<(), ValidationError> {\n    schema.validate(&event.payload).map_err(ValidationError::from)\n}\n",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "e7de190c-5e4f-441a-a2ae-c1fbd4b29971"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "97916e584b04"
              },
              "content": [
                {
                  "text": "Valid events are enqueued; invalid ones go to the DLQ with the error attached.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "blockquote",
      "attrs": {
        "localId": "b4d03fa6-9521-431d-8f63-f3a95587daf9"
      },
      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "localId": "b146570f095d"
          },
          "content": [
            {
              "text": "[!WARNING] Workers must be idempotent. The queue can redeliver a message after a worker crash, so the same event may be written twice.",
              "type": "text"
            }
          ]
        }
      ]
    },
